# ==============================================================================
# Next.js web app configuration
# ==============================================================================
# Copy to `.env.local` for local development. In Docker Compose these values are
# injected from the root `.env` file.

# Public base URL of this web app (used for absolute links and redirects).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Backend service base URLs (server-side only; used by the BFF route handlers).
# Inside Docker Compose these resolve to the service names on the internal
# network. For local development against published ports, use localhost.
# ------------------------------------------------------------------------------
AUTH_SERVICE_URL=http://auth-service:8512
ANALYTICS_SERVICE_URL=http://analytics-service:8517
ADMIN_SERVICE_URL=http://admin-service:8515
RAG_SERVICE_URL=http://rag-service:8516

# ------------------------------------------------------------------------------
# BFF session
# ------------------------------------------------------------------------------
# SECURITY: REQUIRED. Signs the httpOnly session cookie that holds the access
# and refresh tokens. Generate with: openssl rand -hex 32
SESSION_SECRET=

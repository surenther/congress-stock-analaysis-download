.env.senate

# ==============================================================================
# Insomnia API Client Exports (may embed environment secrets)
# ==============================================================================
# Insomnia exports embed the active environment's variables (passwords and
# bearer tokens) in the `environments.data` block. Never commit raw exports.
Insomnia_*.yaml
Insomnia_*.json
insomnia_*.yaml
insomnia_*.json
Insomina_*.yaml
Insomina_*.json
imported_api_collection-*.yaml
imported_api_collection-*.json
*.insomnia.*
.insomnia/

# ==============================================================================
# Internal Planning / Scratch Documents (not part of the shipped project)
# ==============================================================================
# Design notes and work-in-progress plans. Kept locally, never published.
plans/

# ==============================================================================
# Downloaded Data & Output Files (Store outside Git)
# ==============================================================================
data/
house_rep/
senate/
downloads/
*.zip
*.xml
*.pdf
*.html

# ==============================================================================
# Processed Text & Vector Index Outputs (generated by downstream services)
# ==============================================================================
processed_text/
vector_index/
*.npy
*.faiss
*.index

# ==============================================================================
# macOS System Files
# ==============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes


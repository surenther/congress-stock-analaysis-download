# ==============================================================================
# Docker Compose configuration
# This file is read by docker-compose (next to docker-compose.yml) to choose
# where downloaded filings are stored on the HOST and to configure the
# PostgreSQL database and JWT authentication.
# ==============================================================================

# ------------------------------------------------------------------------------
# Storage
# ------------------------------------------------------------------------------
# Set this to the host folder where you want filings stored.
# The app always writes to /data inside the container, which maps to this folder.
#
#   OUTPUT_BASE_DIR=/data                            -> stores in ./data next to this file
#   OUTPUT_BASE_DIR=/home/surenther/unraid/stock-ai  -> stores in that host folder
#
# Leave empty to use the default (./data next to this file).
OUTPUT_BASE_DIR=

# ------------------------------------------------------------------------------
# PostgreSQL (pgvector/pgvector:pg16)
# ------------------------------------------------------------------------------
POSTGRES_USER=congress
POSTGRES_PASSWORD=congress_secret
POSTGRES_DB=congress_db
# Host port mapped to the container's 5432. Change if 5432 is already in use.
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# JWT Authentication (shared by auth-service and downloader)
# ------------------------------------------------------------------------------
# IMPORTANT: Change this to a long, random secret in production.
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ------------------------------------------------------------------------------
# Service ports
# ------------------------------------------------------------------------------
PORT=8511
AUTH_PORT=8512

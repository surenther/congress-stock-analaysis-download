# ==============================================================================
# Congressional Financial Disclosures Platform — Docker Compose configuration
# ==============================================================================
# Copy this file to `.env` (next to docker-compose.yml) and adjust the values:
#
#     cp .env.example .env
#
# Docker Compose automatically reads `.env` and substitutes the ${VAR} /
# ${VAR:-default} references in docker-compose.yml. The resolved values are then
# injected into each container's environment and used for the host volume mount.
#
# See the "Master Environment Variables Reference" section of README.md for the
# full, categorized documentation of every variable below.
# ==============================================================================

# ------------------------------------------------------------------------------
# Storage
# ------------------------------------------------------------------------------
# Host folder where downloaded filings are stored.
# The app ALWAYS writes to /data inside the container; this variable only
# controls the HOST side of the bind mount (${OUTPUT_BASE_DIR:-./data}:/data).
#
#   OUTPUT_BASE_DIR=./data                            -> ./data next to this file
#   OUTPUT_BASE_DIR=/mnt/storage/congress-data        -> that host folder
#
# Leave empty to use the default (./data next to this file).
# SECURITY: contains only public disclosure records, but keep the path out of
# version control and apply appropriate filesystem permissions.
OUTPUT_BASE_DIR=

# ------------------------------------------------------------------------------
# Container registry (image names)
# ------------------------------------------------------------------------------
# Prefix used for the built image names in docker-compose.yml. Set this to your
# own registry (and optional namespace), or leave the default for Docker Hub.
#
#   IMAGE_REGISTRY=docker.io/congress     -> docker.io/congress/congress-auth:latest
#   IMAGE_REGISTRY=registry.example.com   -> registry.example.com/congress-auth:latest
#   IMAGE_REGISTRY=ghcr.io/myorg          -> ghcr.io/myorg/congress-auth:latest
#
# The Gitea build workflow reads the same value from a repository variable named
# IMAGE_REGISTRY (Gitea → Repository → Settings → Actions → Variables).
IMAGE_REGISTRY=docker.io/congress

# ------------------------------------------------------------------------------
# PostgreSQL (pgvector/pgvector:pg16)
# ------------------------------------------------------------------------------
# SECURITY: REQUIRED. There is no default — Compose refuses to start until you
# set a strong value here. Generate one with: openssl rand -hex 32
# The database is NOT published to the host (see docker-compose.yml); it is
# reachable only on the internal Compose network.
POSTGRES_USER=congress
POSTGRES_PASSWORD=
POSTGRES_DB=congress_db
# Host port for the database. Only used if you uncomment the `ports:` mapping
# in docker-compose.yml for local debugging.
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# JWT Authentication (shared by all services)
# ------------------------------------------------------------------------------
# SECURITY: REQUIRED. JWT_SECRET_KEY is the most sensitive value in the system —
# anyone who knows it can forge tokens. There is no default: the services refuse
# to start with a missing, short (<32 char), or placeholder value. Generate one:
#     openssl rand -hex 32
# It MUST be identical for the auth-service, downloader, parser, vectorizer, and
# admin services.
# Never commit the real `.env` to version control.
# NOTE: the signing algorithm is fixed to HS256 in code and is not configurable.
JWT_SECRET_KEY=
# Access-token lifetime in minutes (read by the auth-service when minting tokens).
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ------------------------------------------------------------------------------
# LLM Providers & LiteLLM Proxy (used by the parser and vectorizer services)
# ------------------------------------------------------------------------------
# The parser service never calls an LLM provider directly. It sends document
# text to the `litellm-proxy` container, which routes the request to one of the
# backends configured in services/parser/litellm_config.yaml based on the
# requested model alias.
#
# SECURITY: these are real API keys. Never commit the resolved `.env` to version
# control. Leave a provider's key empty if you do not intend to use it.
#
# OpenRouter (default cloud provider — cheap DeepSeek Flash; Gemini 3.8 Flash costly).
OPENROUTER_API_KEY=
# Hugging Face Inference API (open-weights hosted models, e.g. Qwen 2.5).
HUGGINGFACE_API_KEY=
# OpenAI API key — used by the vectorizer's default embedding model
# (text-embedding-3-small, 1536d) routed through the LiteLLM Proxy.
OPENAI_API_KEY=
# Base URL of a self-hosted Ollama (or vLLM) server for local GPU models.
# From inside the proxy container, `host.docker.internal` reaches the host.
OLLAMA_API_BASE=http://host.docker.internal:11434
# Master key the parser service uses to authenticate to the LiteLLM Proxy.
# SECURITY: REQUIRED. Generate a strong value, e.g.: openssl rand -hex 32
LITELLM_MASTER_KEY=
# Default LiteLLM model alias used when a parse job does not specify one.
# Must match a `model_name` in services/parser/litellm_config.yaml.
LITELLM_DEFAULT_MODEL=openrouter-deepseek-flash
# Enable provider-native JSON mode (response_format=json_object). Off by default
# for maximum provider compatibility; the parser always validates JSON anyway.
LITELLM_USE_JSON_MODE=false
# Only one parse job may run at a time (a second trigger returns 409 Conflict).
# A PENDING/IN_PROGRESS job with no progress for this many hours is treated as
# stale and reaped (marked FAILED) so it cannot block future triggers forever.
# Set to 0 to disable reaping.
PARSER_STALE_JOB_HOURS=2
# Only one download job may run at a time (a second trigger returns 409 Conflict).
# A PENDING/IN_PROGRESS download job with no progress for this many hours is
# treated as stale and reaped (marked FAILED) so it cannot block future triggers
# forever. Set to 0 to disable reaping.
DOWNLOADER_STALE_JOB_HOURS=2
# Only one vectorization job may run at a time (a second trigger returns 409
# Conflict). A PENDING/IN_PROGRESS vectorization job with no progress for this
# many hours is treated as stale and reaped (marked FAILED) so it cannot block
# future triggers forever. Set to 0 to disable reaping.
VECTORIZER_STALE_JOB_HOURS=2
# Default embedding model alias used by the vectorizer service. Must match a
# `model_name` in services/parser/litellm_config.yaml. OpenRouter is the default
# (consistent with the parser's chat model). Options:
#   openrouter-embed (OpenRouter, 1536d)   · text-embedding-3-small (OpenAI, 1536d)
#   hf-embed (Hugging Face free, 384d)     · local-embed (Ollama, 768d)
EMBEDDING_MODEL=openrouter-embed
# Expected embedding dimension — must match the vector(N) column in the
# vectorizer's disclosure_embeddings table. 1536 for openrouter-embed /
# text-embedding-3-small; 384 for hf-embed; 768 for local-embed.
EMBEDDING_DIM=1536
# Number of text chunks sent per embeddings request.
EMBEDDING_BATCH_SIZE=64
# Log verbosity for all services (auth, downloader, parser, vectorizer, admin):
# DEBUG, INFO, WARNING, ERROR (default INFO).
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Service ports (host-side mappings)
# ------------------------------------------------------------------------------
# Downloader API: http://localhost:${PORT}   (Swagger UI at /docs)
PORT=8511
# Auth API:       http://localhost:${AUTH_PORT}   (Swagger UI at /docs)
AUTH_PORT=8512
# Parser API:     http://localhost:${PARSER_PORT}   (Swagger UI at /docs)
PARSER_PORT=8513
# Vectorizer API: http://localhost:${VECTORIZER_PORT}   (Swagger UI at /docs)
VECTORIZER_PORT=8514
# Admin API:      http://localhost:${ADMIN_PORT}   (Swagger UI at /docs)
ADMIN_PORT=8515
# LiteLLM Proxy:  http://localhost:${LITELLM_PORT}   (OpenAI-compatible API)
LITELLM_PORT=4000

# ==============================================================================
# NOTE: The downloader's chamber-specific settings (URLs, date ranges, filters)
# live in separate files, NOT here:
#   services/downloader/.env.house   (from .env.house.example)
#   services/downloader/.env.senate  (from .env.senate.example)
# See the Downloader Service README for the full list.
#
# NOTE: A SWAG/Nginx reverse proxy is optional and external to this repository;
# it has no variables here. Configure its domain/TLS settings in the proxy.
# ==============================================================================

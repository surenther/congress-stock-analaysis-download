# ==============================================================================
# Automated API Test Environment — Credential Template
# ==============================================================================
# Copy this file to `tests/.env.test` and paste your real values:
#
#     cp tests/.env.test.example tests/.env.test
#
# `tests/.env.test` is git-ignored and is loaded automatically by conftest.py.
# NEVER commit the resolved `tests/.env.test` — it holds real credentials.
#
# The base URLs below match the host-side port mappings in the root `.env`
# (see .env.example). Adjust them if you changed the ports.
# ==============================================================================

# ------------------------------------------------------------------------------
# Service base URLs (host-side)
# ------------------------------------------------------------------------------
# These match the normal stack (docker-compose.yml). If you run the isolated
# test stack instead (docker-compose.test.yml), use the shifted ports (+100):
#   AUTH_BASE_URL=http://localhost:8612
#   DOWNLOADER_BASE_URL=http://localhost:8611
#   PARSER_BASE_URL=http://localhost:8613
#   VECTORIZER_BASE_URL=http://localhost:8614
#   ADMIN_BASE_URL=http://localhost:8615
#   RAG_BASE_URL=http://localhost:8616
AUTH_BASE_URL=http://localhost:8512
DOWNLOADER_BASE_URL=http://localhost:8511
PARSER_BASE_URL=http://localhost:8513
VECTORIZER_BASE_URL=http://localhost:8514
ADMIN_BASE_URL=http://localhost:8515
RAG_BASE_URL=http://localhost:8516

# ------------------------------------------------------------------------------
# Login-based credentials
# ------------------------------------------------------------------------------
# These accounts must already exist in the database (see
# services/auth-service/scripts/create_user.sql). Tests that need a token will
# log in with these. Leave a pair blank to skip the tests that depend on it.
#
# Admin: full access (trigger jobs, admin-service, both chambers in RAG).
TEST_ADMIN_USERNAME=
TEST_ADMIN_PASSWORD=
# Read-only user: status/document retrieval + RAG within allowed_chambers.
TEST_USER_USERNAME=
TEST_USER_PASSWORD=
# House-only user: used to verify RAG CBAC returns 403 for Senate queries.
TEST_HOUSE_USER_USERNAME=
TEST_HOUSE_USER_PASSWORD=
# Senate-only user: used to verify RAG CBAC returns 403 for House queries.
TEST_SENATE_USER_USERNAME=
TEST_SENATE_USER_PASSWORD=

# ------------------------------------------------------------------------------
# Offline token minting (optional)
# ------------------------------------------------------------------------------
# If set, conftest.py can mint JWTs directly (mirrors
# services/rag/scripts/mint_test_token.py) instead of logging in. This is handy
# for CBAC tests that need a specific allowed_chambers grant. Must match the
# JWT_SECRET_KEY used by the running stack.
JWT_SECRET_KEY=
JWT_ISSUER=congress-auth
JWT_AUDIENCE=congress-platform

# ------------------------------------------------------------------------------
# Test data & behavior toggles
# ------------------------------------------------------------------------------
# A known doc_id that has been downloaded AND parsed, used by parser/vectorizer
# document-retrieval tests. Leave blank to skip those tests.
TEST_DOC_ID=
# Chamber used for trigger tests: house, senate, or all.
TEST_CHAMBER=house
# When false (default), LLM-spending integration tests are skipped. Set to true
# to actually trigger downloader/parser/vectorizer jobs and poll to completion.
RUN_LLM_TESTS=false
# Job polling bounds (seconds).
JOB_POLL_TIMEOUT_SECONDS=120
JOB_POLL_INTERVAL_SECONDS=2
